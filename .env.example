# AgentWall Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=AgentWall
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://agentwall:agentwall@localhost:5432/agentwall

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# Upstream Tool Servers
FILESYSTEM_SERVER_URL=http://localhost:8001
DATABASE_SERVER_URL=http://localhost:8002
WEB_FETCH_SERVER_URL=http://localhost:8003

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Approval Queue
APPROVAL_TIMEOUT_SECONDS=300

# Audit
AUDIT_HASH_ALGORITHM=sha256

# Threat Detection
ENABLE_ML_CLASSIFIER=false
ML_MODEL_PATH=

# DLP
ENABLE_DLP=true

# Egress Allowlist (comma-separated)
EGRESS_ALLOWLIST=http://localhost:8001,http://localhost:8002,http://localhost:8003

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Dashboard
VITE_API_URL=http://localhost:8000